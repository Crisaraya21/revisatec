# Archivo de ejemplo para variables de entorno del frontend de RevisaTEC.
# Copia este archivo como .env.local para desarrollo local (nunca se sube al repo).

# URL base de los microservicios en Azure APIM (en desarrollo se usa el proxy de Vite)
VITE_API_BASE_URL=https://apimanagementcristopherarayavega.azure-api.net/revisatec

# Clave de suscripción de Azure APIM
VITE_API_SUBSCRIPTION_KEY=

# Fuente de datos para la campana de notificaciones: "api" (por defecto) o "mock"
VITE_NOTIFICATIONS_SOURCE=api

# (Opcional, solo desarrollo): URL directa de MS3 local
# Si se deja vacío, las peticiones van a través de APIM / proxy
# VITE_NOTIFICATIONS_BASE_URL=http://localhost:3000
