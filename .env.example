# Archivo de ejemplo para variables de entorno del frontend de RevisaTEC.
# Copia este archivo como .env.local para desarrollo local (nunca se sube al repo).

# URL base del APIM (en desarrollo se usa el proxy de Vite)
VITE_API_BASE_URL=https://apimanagementcristopherarayavega.azure-api.net/revisatec

# Clave de suscripcion de Azure APIM
VITE_API_SUBSCRIPTION_KEY=

# Alias de la clave (compatibilidad con versiones anteriores)
VITE_API_KEY=

# Google OAuth Client ID para el boton de inicio de sesion con Google (vista estudiante)
VITE_GOOGLE_CLIENT_ID=

# Fuente de datos para notificaciones: "api" (produccion) o "mock" (desarrollo sin MS3)
# Cuando es "api", el sistema llama a APIM /notifications/* (ms-notifications de Cris).
# Cuando es "mock", usa los datos de src/notifications/mockNotifications.js.
VITE_NOTIFICATIONS_SOURCE=api

# (Opcional) URL directa a MS3 en local sin pasar por APIM.
# Si se deja vacio, las peticiones van a traves del proxy de Vite -> APIM.
# VITE_NOTIFICATIONS_BASE_URL=http://localhost:3000
